<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.deer.wcs.base.dao.WareInfoMapper">
    
    <resultMap type="com.deer.wcs.base.model.WareInfo" id="WareInfoResult">
        <result property="id"    column="id"    />
        <result property="code"    column="code"    />
        <result property="name"    column="name"    />
        <result property="createTime"    column="create_time"    />
        <result property="createUserId"    column="create_user_id"    />
        <result property="createUserName"    column="create_user_name"    />
        <result property="updateTime"    column="update_time"    />
        <result property="updateUserId"    column="update_user_id"    />
        <result property="updateUserName"    column="update_user_name"    />
        <result property="version"    column="version"    />
        <result property="isDelete"    column="is_delete"    />
        <result property="isTest"    column="is_test"    />
    </resultMap>

    <resultMap id="Dto" extends="WareInfoResult"  type="com.deer.wcs.base.model.WareInfoDto" >
    </resultMap>

    <sql id="selectWareInfoVo">
        select * from ware_info
    </sql>

    <select id="findList" parameterType="com.deer.wcs.base.model.WareInfoCriteria" resultMap="Dto">
        <include refid="selectWareInfoVo"/>
        <where>
            <if test="code != null  and code != ''"> and code = #{code}</if>
            <if test="name != null  and name != ''"> and name like concat('%', #{name}, '%')</if>
            <if test="createUserId != null "> and create_user_id = #{createUserId}</if>
            <if test="createUserName != null  and createUserName != ''"> and create_user_name like concat('%', #{createUserName}, '%')</if>
            <if test="updateUserId != null "> and update_user_id = #{updateUserId}</if>
            <if test="updateUserName != null  and updateUserName != ''"> and update_user_name like concat('%', #{updateUserName}, '%')</if>
            <if test="isDelete != null "> and is_delete = #{isDelete}</if>
            <if test="disableState != null "> and disable_state = #{disableState}</if>
            <if test="isTest != null "> and is_test = #{isTest}</if>
            <if test="createTime != null  and createTime != ''"> and create_time like concat(#{createTime},'%')</if>
            <if test="updateTime != null  and updateTime != ''"> and update_time like concat(#{updateTime},'%')</if>
        </where>
    </select>
    
    <select id="selectWareInfoById" parameterType="Long" resultMap="WareInfoResult">
        <include refid="selectWareInfoVo"/>
        where id = #{id}
    </select>

    <select id="findAllWareInfos" resultType="com.deer.wcs.base.model.WareInfoDto">
        select code,name from ware_info where is_delete = 0;
    </select>

    <delete id="deleteModel" parameterType="String"  >
        delete from line_info where ware_code = #{wareCode};
        <!-- delete from area_info where wareCode = #{wareCode}; -->
        delete from position_info where ware_code = #{wareCode};
        <!-- delete from position_handle where step_code in (select step_code from position_condition where ware_code = #{wareCode}); -->
        delete from position_condition where ware_code = #{wareCode};
    </delete>
        
    <insert id="insertWareInfo" parameterType="com.deer.wcs.base.model.WareInfo">
        insert into ware_info
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="id != null">id,</if>
            <if test="code != null">code,</if>
            <if test="name != null">name,</if>
            <if test="createTime != null">create_time,</if>
            <if test="createUserId != null">create_user_id,</if>
            <if test="createUserName != null">create_user_name,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="updateUserId != null">update_user_id,</if>
            <if test="updateUserName != null">update_user_name,</if>
            <if test="version != null">version,</if>
            <if test="isDelete != null">is_delete,</if>
            <if test="isTest != null">is_test,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="id != null">#{id},</if>
            <if test="code != null">#{code},</if>
            <if test="name != null">#{name},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="createUserId != null">#{createUserId},</if>
            <if test="createUserName != null">#{createUserName},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="updateUserId != null">#{updateUserId},</if>
            <if test="updateUserName != null">#{updateUserName},</if>
            <if test="version != null">#{version},</if>
            <if test="isTest != null">#{isTest},</if>
         </trim>
    </insert>

    <update id="updateWareInfo" parameterType="com.deer.wcs.base.model.WareInfo">
        update ware_info
        <trim prefix="SET" suffixOverrides=",">
            <if test="code != null">code = #{code},</if>
            <if test="name != null">name = #{name},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="createUserId != null">create_user_id = #{createUserId},</if>
            <if test="createUserName != null">create_user_name = #{createUserName},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="updateUserId != null">update_user_id = #{updateUserId},</if>
            <if test="updateUserName != null">update_user_name = #{updateUserName},</if>
            <if test="version != null">version = #{version},</if>
            <if test="isDelete != null">is_delete = #{isDelete},</if>
            <if test="isTest != null">is_test = #{isTest},</if>
        </trim>
        where id = #{id}
    </update>

    <update id="updateAllLinkWareId" parameterType="wareInfoUpdate">
        update area_info set ware_code = #{newWareCode} , ware_name = #{newWareName} where ware_code = #{oldWareCode};
        update line_info set ware_code = #{newWareCode} , ware_name = #{newWareName} where ware_code = #{oldWareCode};
        update cell_info set ware_code = #{newWareCode} , ware_name = #{newWareName} where ware_code = #{oldWareCode};
        update position_info set ware_code = #{newWareCode} , ware_name = #{newWareName} where ware_code = #{oldWareCode};
        update call_box_info set ware_code = #{newWareCode} , ware_name = #{newWareName} where ware_code = #{oldWareCode};
        update code_scanner_info set ware_code = #{newWareCode} , ware_name = #{newWareName} where ware_code = #{oldWareCode};
        update task_type set ware_code = #{newWareCode} , ware_name = #{newWareName} where ware_code = #{oldWareCode};
        update task_define set ware_code = #{newWareCode}  where ware_code = #{oldWareCode};
    </update>

    <delete id="deleteWareInfoById" parameterType="Long">
        delete from ware_info where id = #{id}
    </delete>

    <delete id="deleteWareInfoByIds" parameterType="String">
        delete from ware_info where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>
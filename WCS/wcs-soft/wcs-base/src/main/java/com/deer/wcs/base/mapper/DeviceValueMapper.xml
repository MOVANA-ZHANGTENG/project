<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.deer.wcs.base.dao.DeviceValueMapper">
    
    <resultMap type="com.deer.wcs.base.model.DeviceValue" id="DeviceValueResult">
        <result property="id"    column="id"    />
        <result property="code"    column="code"    />
        <result property="name"    column="name"    />
        <result property="deviceCode"    column="device_code"    />
        <result property="deviceName"    column="device_name"    />
        <result property="comType"    column="com_type"    />
        <result property="ip"    column="ip"    />
        <result property="port"    column="port"    />
        <result property="address"    column="address"    />
        <result property="plcType"    column="plc_type"    />
        <result property="length"    column="length"    />
        <result property="readValue"    column="read_value"    />
        <result property="readTime"    column="read_time"    />
        <result property="writeValue"    column="write_value"    />
        <result property="writeTime"    column="write_time"    />
        <result property="createTime"    column="create_time"    />
        <result property="createUserId"    column="create_user_id"    />
        <result property="createUserName"    column="create_user_name"    />
        <result property="updateTime"    column="update_time"    />
        <result property="updateUserId"    column="update_user_id"    />
        <result property="updateUserName"    column="update_user_name"    />
        <result property="version"    column="version"    />
        <result property="isDelete"    column="is_delete"    />
    </resultMap>

    <resultMap id="Dto" extends="DeviceValueResult"  type="com.deer.wcs.base.model.DeviceValueDto" >
    </resultMap>

    <sql id="selectDeviceValueVo">
        select * from device_value
    </sql>

    <select id="findList" parameterType="com.deer.wcs.base.model.DeviceValueCriteria" resultMap="Dto">
        <include refid="selectDeviceValueVo"/>
        <where>
            <if test="code != null  and code != ''"> and code = #{code}</if>
            <if test="name != null  and name != ''"> and name like concat('%', #{name}, '%')</if>
            <if test="deviceCode != null  and deviceCode != ''"> and device_code = #{deviceCode}</if>
            <if test="deviceName != null  and deviceName != ''"> and device_name like concat('%', #{deviceName}, '%')</if>
            <if test="comType != null "> and com_type = #{comType}</if>
            <if test="s7Type != null "> and s7_type = #{s7Type}</if>
            <if test="modbusType != null "> and modbus_type = #{modbusType}</if>
            <if test="ip != null  and ip != ''"> and ip = #{ip}</if>
            <if test="port != null  and port != ''"> and port = #{port}</if>
            <if test="address != null  and address != ''"> and address = #{address}</if>
            <if test="plcType != null "> and plc_type = #{plcType}</if>
            <if test="javaType != null "> and java_type = #{javaType}</if>
            <if test="readValue != null  and readValue != ''"> and read_value = #{readValue}</if>
            <if test="readTime != null  and readTime != ''"> and read_time = #{readTime}</if>
            <if test="writeValue != null  and writeValue != ''"> and write_value = #{writeValue}</if>
            <if test="writeTime != null  and writeTime != ''"> and write_time = #{writeTime}</if>
            <if test="createUserId != null "> and create_user_id = #{createUserId}</if>
            <if test="createUserName != null  and createUserName != ''"> and create_user_name like concat('%', #{createUserName}, '%')</if>
            <if test="updateUserId != null "> and update_user_id = #{updateUserId}</if>
            <if test="updateUserName != null "> and update_user_name like concat('%', #{updateUserName}, '%')</if>
            <if test="isDelete != null "> and is_delete = #{isDelete}</if>
            <if test="updateTime != null  and updateTime != ''"> and update_time like concat(#{updateTime},'%')</if>
            <if test="createTime != null  and createTime != ''"> and create_time like concat(#{createTime},'%')</if>
        </where>
    </select>
    
    <select id="selectDeviceValueById" parameterType="Long" resultMap="DeviceValueResult">
        <include refid="selectDeviceValueVo"/>
        where id = #{id}
    </select>
        
    <insert id="insertDeviceValue" parameterType="com.deer.wcs.base.model.DeviceValue" useGeneratedKeys="true" keyProperty="id">
        insert into device_value
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="code != null">code,</if>
            <if test="name != null">name,</if>
            <if test="deviceCode != null and deviceCode != ''">device_code,</if>
            <if test="deviceName != null and deviceName != ''">device_name,</if>
            <if test="comType != null">com_type,</if>
            <if test="ip != null">ip,</if>
            <if test="port != null">port,</if>
            <if test="address != null and address != ''">address,</if>
            <if test="plcType != null and plcType != ''">plc_type,</if>
            <if test="length != null">length,</if>
            <if test="readValue != null">read_value,</if>
            <if test="readTime != null">read_time,</if>
            <if test="writeValue != null">write_value,</if>
            <if test="writeTime != null">write_time,</if>
            <if test="createTime != null">create_time,</if>
            <if test="createUserId != null">create_user_id,</if>
            <if test="createUserName != null">create_user_name,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="updateUserId != null">update_user_id,</if>
            <if test="updateUserName != null">update_user_name,</if>
            <if test="version != null">version,</if>
            <if test="isDelete != null">is_delete,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="code != null">#{code},</if>
            <if test="name != null">#{name},</if>
            <if test="deviceCode != null and deviceCode != ''">#{deviceCode},</if>
            <if test="deviceName != null and deviceName != ''">#{deviceName},</if>
            <if test="comType != null">#{comType},</if>
            <if test="ip != null">#{ip},</if>
            <if test="port != null">#{port},</if>
            <if test="address != null and address != ''">#{address},</if>
            <if test="plcType != null and plcType != ''">#{plcType},</if>
            <if test="length != null">#{length},</if>
            <if test="readValue != null">#{readValue},</if>
            <if test="readTime != null">#{readTime},</if>
            <if test="writeValue != null">#{writeValue},</if>
            <if test="writeTime != null">#{writeTime},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="createUserId != null">#{createUserId},</if>
            <if test="createUserName != null">#{createUserName},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="updateUserId != null">#{updateUserId},</if>
            <if test="updateUserName != null">#{updateUserName},</if>
            <if test="version != null">#{version},</if>
            <if test="isDelete != null">#{isDelete},</if>
         </trim>
    </insert>

    <update id="updateDeviceValue" parameterType="com.deer.wcs.base.model.DeviceValue">
        update device_value
        <trim prefix="SET" suffixOverrides=",">
            <if test="code != null">code = #{code},</if>
            <if test="name != null">name = #{name},</if>
            <if test="deviceCode != null and deviceCode != ''">device_code = #{deviceCode},</if>
            <if test="deviceName != null and deviceName != ''">device_name = #{deviceName},</if>
            <if test="comType != null">com_type = #{comType},</if>
            <if test="ip != null">ip = #{ip},</if>
            <if test="port != null">port = #{port},</if>
            <if test="address != null and address != ''">address = #{address},</if>
            <if test="plcType != null and plcType != ''">plc_type = #{plcType},</if>
            <if test="length != null">length = #{length},</if>
            <if test="readValue != null">read_value = #{readValue},</if>
            <if test="readTime != null">read_time = #{readTime},</if>
            <if test="writeValue != null">write_value = #{writeValue},</if>
            <if test="writeTime != null">write_time = #{writeTime},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="createUserId != null">create_user_id = #{createUserId},</if>
            <if test="createUserName != null">create_user_name = #{createUserName},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="updateUserId != null">update_user_id = #{updateUserId},</if>
            <if test="updateUserName != null">update_user_name = #{updateUserName},</if>
            <if test="version != null">version = #{version},</if>
            <if test="isDelete != null">is_delete = #{isDelete},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteDeviceValueById" parameterType="Long">
        delete from device_value where id = #{id}
    </delete>

    <delete id="deleteDeviceValueByIds" parameterType="String">
        delete from device_value where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

    <delete id="deleteByDeviceIds">
        delete from device_value where device_id in
        <foreach item="deviceId" collection="array" open="(" separator="," close=")">
            #{deviceId}
        </foreach>
    </delete>
</mapper>
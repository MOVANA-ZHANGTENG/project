<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.deer.wcs.base.dao.PathInfoMapper">
    
    <resultMap type="com.deer.wcs.base.model.PathInfo" id="PathInfoResult">
        <result property="id"    column="id"    />
        <result property="taskId"    column="task_id"    />
        <result property="taskNo"    column="task_no"    />
        <result property="jobId"    column="job_id"    />
        <result property="pathIndex"    column="path_index"    />
        <result property="type"    column="type"    />
        <result property="palletCode"    column="pallet_code"    />
        <result property="fromCellCode"    column="from_cell_code"    />
        <result property="toCellCode"    column="to_cell_code"    />
        <result property="createTime"    column="create_time"    />
        <result property="state"    column="state"    />
        <result property="cmdTime"    column="cmd_time"    />
        <result property="finishTime"    column="finish_time"    />
    </resultMap>

    <resultMap id="Dto" extends="PathInfoResult"  type="com.deer.wcs.base.model.PathInfoDto" >
    </resultMap>

    <sql id="selectPathInfoVo">
        select * from path_info
    </sql>

    <select id="findList" parameterType="com.deer.wcs.base.model.PathInfoCriteria" resultMap="Dto">
        <include refid="selectPathInfoVo"/>
        <where>  
            <if test="taskId != null "> and task_id = #{taskId}</if>
            <if test="taskNo != null  and taskNo != ''"> and task_no = #{taskNo}</if>
            <if test="jobId != null "> and job_id = #{jobId}</if>
            <if test="pathIndex != null "> and path_index = #{pathIndex}</if>
            <if test="type != null  and type != ''"> and type = #{type}</if>
            <if test="palletCode != null  and palletCode != ''"> and pallet_code = #{palletCode}</if>
            <if test="fromCellCode != null  and fromCellCode != ''"> and from_cell_code = #{fromCellCode}</if>
            <if test="toCellCode != null  and toCellCode != ''"> and to_cell_code = #{toCellCode}</if>
            <if test="state != null  and state != ''"> and state = #{state}</if>
            <if test="wareCode != null  and wareCode != ''"> and ware_code = #{wareCode}</if>
            <if test="wareName != null  and wareName != ''"> and ware_name like concat('%', #{wareName}, '%')</if>
            <if test="createTime != null  and createTime != ''"> and create_time like concat(#{createTime},'%')</if>
            <if test="cmdTime != null  and cmdTime != ''"> and cmd_time like concat(#{cmdTime},'%')</if>
            <if test="finishTime != null  and finishTime != ''"> and finish_time like concat(#{finishTime},'%')</if>
        </where>
    </select>
    
    <select id="selectPathInfoById" parameterType="Long" resultMap="PathInfoResult">
        <include refid="selectPathInfoVo"/>
        where id = #{id}
    </select>

    <select id="findPathListByJobId" resultType="com.deer.wcs.base.model.PathInfo">
        <include refid="selectPathInfoVo"/>
        where job_id = #{jobId} order by path_index
    </select>
    <select id="findPathHisListByJobId" resultType="com.deer.wcs.base.model.PathInfo">
        select id,name, task_id, task_no, job_id, path_index, type, pallet_code, from_cell_code, to_cell_code, create_time, state, cmd_time, finish_time,ware_code,ware_name,memo from path_info_history
        where job_id = #{jobId} order by path_index
    </select>

    <insert id="insertPathInfo" parameterType="com.deer.wcs.base.model.PathInfo" useGeneratedKeys="true" keyProperty="id">
        insert into path_info
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="taskId != null">task_id,</if>
            <if test="taskNo != null">task_no,</if>
            <if test="jobId != null">job_id,</if>
            <if test="pathIndex != null">path_index,</if>
            <if test="type != null">type,</if>
            <if test="palletCode != null">pallet_code,</if>
            <if test="fromCellCode != null">from_cell_code,</if>
            <if test="toCellCode != null">to_cell_code,</if>
            <if test="createTime != null">create_time,</if>
            <if test="state != null">state,</if>
            <if test="cmdTime != null">cmd_time,</if>
            <if test="finishTime != null">finish_time,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="taskId != null">#{taskId},</if>
            <if test="taskNo != null">#{taskNo},</if>
            <if test="jobId != null">#{jobId},</if>
            <if test="pathIndex != null">#{pathIndex},</if>
            <if test="type != null">#{type},</if>
            <if test="palletCode != null">#{palletCode},</if>
            <if test="fromCellCode != null">#{fromCellCode},</if>
            <if test="toCellCode != null">#{toCellCode},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="state != null">#{state},</if>
            <if test="cmdTime != null">#{cmdTime},</if>
            <if test="finishTime != null">#{finishTime},</if>
         </trim>
    </insert>

    <update id="updatePathInfo" parameterType="com.deer.wcs.base.model.PathInfo">
        update path_info
        <trim prefix="SET" suffixOverrides=",">
            <if test="taskId != null">task_id = #{taskId},</if>
            <if test="taskNo != null">task_no = #{taskNo},</if>
            <if test="jobId != null">job_id = #{jobId},</if>
            <if test="pathIndex != null">path_index = #{pathIndex},</if>
            <if test="type != null">type = #{type},</if>
            <if test="palletCode != null">pallet_code = #{palletCode},</if>
            <if test="fromCellCode != null">from_cell_code = #{fromCellCode},</if>
            <if test="toCellCode != null">to_cell_code = #{toCellCode},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="state != null">state = #{state},</if>
            <if test="cmdTime != null">cmd_time = #{cmdTime},</if>
            <if test="finishTime != null">finish_time = #{finishTime},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deletePathInfoById" parameterType="Long">
        delete from path_info where id = #{id}
    </delete>

    <delete id="deletePathInfoByIds" parameterType="String">
        delete from path_info where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>
    <resultMap id="Dto" extends="WmsTaskInfoResult"  type="com.deer.wcs.base.model.WmsTaskInfoDto" >
    </resultMap>

    <sql id="selectWmsTaskInfoVo">
        select * from wms_task_info
    </sql>

    <select id="findList" parameterType="com.deer.wcs.base.model.WmsTaskInfoCriteria" resultMap="Dto">
        <include refid="selectWmsTaskInfoVo"/>
        <where>  
            <if test="taskNo != null "> and task_no = #{taskNo}</if>
            <if test="wareCode != null  and wareCode != ''"> and ware_code = #{wareCode}</if>
            <if test="wareName != null  and wareName != ''"> and ware_name like concat('%', #{wareName}, '%')</if>
            <if test="areaCode != null  and areaCode != ''"> and area_code = #{areaCode}</if>
            <if test="areaName != null  and areaName != ''"> and area_name like concat('%', #{areaName}, '%')</if>
            <if test="type != null  and type != ''"> and type = #{type}</if>
            <if test="palletCode != null  and palletCode != ''"> and pallet_code = #{palletCode}</if>
            <if test="fromCellCode != null  and fromCellCode != ''"> and from_cell_code = #{fromCellCode}</if>
            <if test="toCellCode != null  and toCellCode != ''"> and to_cell_code = #{toCellCode}</if>
            <if test="state != null  and state != ''"> and state = #{state}</if>
            <if test="priority != null "> and priority = #{priority}</if>
            <if test="createTime != null  and createTime != ''"> and create_time like concat(#{createTime},'%')</if>
        </where>
    </select>
    
    <select id="selectWmsTaskInfoById" parameterType="Long" resultMap="WmsTaskInfoResult">
        <include refid="selectWmsTaskInfoVo"/>
        where id = #{id}
    </select>
        
    <insert id="insertWmsTaskInfo" parameterType="com.deer.wcs.base.model.WmsTaskInfo">

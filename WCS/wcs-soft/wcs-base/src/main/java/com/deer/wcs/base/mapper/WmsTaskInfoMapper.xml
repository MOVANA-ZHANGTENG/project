            <if test="taskNo != null">task_no,</if>
            <if test="wareCode != null">ware_code,</if>
            <if test="wareName != null">ware_name,</if>
            <if test="areaCode != null">area_code,</if>
            <if test="areaName != null">area_name,</if>
            <if test="type != null">type,</if>
            <if test="palletCode != null">pallet_code,</if>
            <if test="fromCellCode != null">from_cell_code,</if>
            <if test="toCellCode != null">to_cell_code,</if>
            <if test="createTime != null">create_time,</if>
            <if test="state != null">state,</if>
            <if test="version != null">version,</if>
            <if test="priority != null">priority,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">

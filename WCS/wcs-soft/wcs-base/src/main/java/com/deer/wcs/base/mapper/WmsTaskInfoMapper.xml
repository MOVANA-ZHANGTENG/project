            <if test="toCellCode != null">to_cell_code = #{toCellCode},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="state != null">state = #{state},</if>
            <if test="version != null">version = #{version},</if>
            <if test="priority != null">priority = #{priority},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteWmsTaskInfoById" parameterType="Long">
        delete from wms_task_info where id = #{id}
    </delete>

    <delete id="deleteWmsTaskInfoByIds" parameterType="String">
        delete from wms_task_info where id in 

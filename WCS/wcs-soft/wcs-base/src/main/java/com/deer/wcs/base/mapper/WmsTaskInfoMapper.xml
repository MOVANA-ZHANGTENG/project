<mapper namespace="com.deer.wcs.base.dao.WmsTaskInfoMapper">
    
    <resultMap type="com.deer.wcs.base.model.WmsTaskInfo" id="WmsTaskInfoResult">
        <result property="id"    column="id"    />
        <result property="taskNo"    column="task_no"    />
        <result property="wareCode"    column="ware_code"    />
        <result property="wareName"    column="ware_name"    />
        <result property="areaCode"    column="area_code"    />
        <result property="areaName"    column="area_name"    />

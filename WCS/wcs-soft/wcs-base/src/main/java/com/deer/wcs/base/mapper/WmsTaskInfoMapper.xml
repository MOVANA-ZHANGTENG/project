            <if test="fromCellCode != null">#{fromCellCode},</if>
            <if test="toCellCode != null">#{toCellCode},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="state != null">#{state},</if>
            <if test="version != null">#{version},</if>
            <if test="priority != null">#{priority},</if>
         </trim>
    </insert>

    <update id="updateWmsTaskInfo" parameterType="com.deer.wcs.base.model.WmsTaskInfo">
        update wms_task_info
        <trim prefix="SET" suffixOverrides=",">
            <if test="taskNo != null">task_no = #{taskNo},</if>
            <if test="wareCode != null">ware_code = #{wareCode},</if>
            <if test="wareName != null">ware_name = #{wareName},</if>

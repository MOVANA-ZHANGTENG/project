<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.deer.wcs.base.dao.PositionStepMapper">
    
    <resultMap type="com.deer.wcs.base.model.PositionStep" id="PositionStepResult">
        <result property="id"    column="id"    />
        <result property="code"    column="code"    />
        <result property="name"    column="name"    />
        <result property="wareCode"    column="ware_code"    />
        <result property="wareName"    column="ware_name"    />
    </resultMap>

    <resultMap id="Dto" extends="PositionStepResult"  type="com.deer.wcs.base.model.PositionStepDto" >
        <collection property="cmdPreList" ofType="positionStepDto"
                    select="getCmdPreList" column="code">
        </collection>
        <collection property="cmdList" ofType="positionStepDto"
                    select="getCmdList" column="code">
        </collection>
        <collection property="successPreList" ofType="positionStepDto"
                    select="getSuccessPreList" column="code">
        </collection>
        <collection property="successList" ofType="positionStepDto"
                    select="getSuccessList" column="code">
        </collection>
        <collection property="deleteList" ofType="positionStepDto"
                    select="getDeleteList" column="code">
        </collection>
    </resultMap>

    <select id="getCmdPreList" parameterType="positionStepDto" resultType="com.deer.wcs.base.model.PositionHandle">
        select * from position_handle
        where step_code = #{code} and type = 1
    </select>
    <select id="getCmdList" parameterType="positionStepDto" resultType="com.deer.wcs.base.model.PositionHandle">
        select * from position_handle
        where step_code = #{code} and type = 2
    </select>
    <select id="getSuccessPreList" parameterType="positionStepDto" resultType="com.deer.wcs.base.model.PositionHandle">
        select * from position_handle
        where step_code = #{code} and type = 3
    </select>
    <select id="getSuccessList" parameterType="positionStepDto" resultType="com.deer.wcs.base.model.PositionHandle">
        select * from position_handle
        where step_code = #{code} and type = 4
    </select>
    <select id="getDeleteList" parameterType="positionStepDto" resultType="com.deer.wcs.base.model.PositionHandle">
        select * from position_handle
        where step_code = #{code} and type = 5
    </select>

    <sql id="selectPositionStepVo">
        select id, code, name, ware_code, ware_name from position_step
    </sql>

    <select id="findList" parameterType="com.deer.wcs.base.model.PositionStepCriteria" resultMap="Dto">
        <include refid="selectPositionStepVo"/>
        <where>  
            <if test="code != null  and code != ''"> and code = #{code}</if>
            <if test="name != null  and name != ''"> and name like concat('%', #{name}, '%')</if>
            <if test="wareCode != null  and wareCode != ''"> and ware_code = #{wareCode}</if>
            <if test="wareName != null  and wareName != ''"> and ware_name like concat('%', #{wareName}, '%')</if>
        </where>
    </select>
    
    <select id="selectPositionStepById" parameterType="Long" resultMap="PositionStepResult">
        <include refid="selectPositionStepVo"/>
        where id = #{id}
    </select>
        
    <insert id="insertPositionStep" parameterType="com.deer.wcs.base.model.PositionStep">
        insert into position_step
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="id != null">id,</if>
            <if test="code != null">code,</if>
            <if test="name != null">name,</if>
            <if test="wareCode != null">ware_code,</if>
            <if test="wareName != null">ware_name,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="id != null">#{id},</if>
            <if test="code != null">#{code},</if>
            <if test="name != null">#{name},</if>
            <if test="wareCode != null">#{wareCode},</if>
            <if test="wareName != null">#{wareName},</if>
         </trim>
    </insert>

    <update id="updatePositionStep" parameterType="com.deer.wcs.base.model.PositionStep">
        update position_step
        <trim prefix="SET" suffixOverrides=",">
            <if test="code != null">code = #{code},</if>
            <if test="name != null">name = #{name},</if>
            <if test="wareCode != null">ware_code = #{wareCode},</if>
            <if test="wareName != null">ware_name = #{wareName},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deletePositionStepById" parameterType="Long">
        delete from position_step where id = #{id}
    </delete>

    <delete id="deletePositionStepByIds" parameterType="String">
        delete from position_step where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>
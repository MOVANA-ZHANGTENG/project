<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.deer.wcs.base.dao.FloorInfoMapper">
    
    <resultMap type="com.deer.wcs.base.model.FloorInfo" id="FloorInfoResult">
        <result property="id"    column="id"    />
        <result property="wareCode"    column="ware_code"    />
        <result property="wareName"    column="ware_name"    />
        <result property="areaCode"    column="area_code"    />
        <result property="z"    column="z"    />
        <result property="disableState"    column="disable_state"    />
        <result property="createTime"    column="create_time"    />
        <result property="createUserId"    column="create_user_id"    />
        <result property="createUserName"    column="create_user_name"    />
        <result property="totalX"    column="total_x"    />
        <result property="totalY"    column="total_y"    />
        <result property="xy"    column="xy"    />
    </resultMap>

    <resultMap id="Dto" extends="FloorInfoResult"  type="com.deer.wcs.base.model.FloorInfoDto" >
    </resultMap>

    <sql id="selectFloorInfoVo">
        select id, ware_code, ware_name, area_code, z, disable_state, create_time, create_user_id, create_user_name, total_x, total_y, xy from floor_info
    </sql>

    <select id="findList" parameterType="com.deer.wcs.base.model.FloorInfoCriteria" resultMap="Dto">
        <include refid="selectFloorInfoVo"/>
        <where>  
            <if test="wareCode != null  and wareCode != ''"> and ware_code = #{wareCode}</if>
            <if test="wareName != null  and wareName != ''"> and ware_name like concat('%', #{wareName}, '%')</if>
            <if test="areaCode != null  and areaCode != ''"> and area_code = #{areaCode}</if>
            <if test="z != null "> and z = #{z}</if>
            <if test="disableState != null  and disableState != ''"> and disable_state = #{disableState}</if>
            <if test="createUserId != null "> and create_user_id = #{createUserId}</if>
            <if test="createUserName != null  and createUserName != ''"> and create_user_name like concat('%', #{createUserName}, '%')</if>
            <if test="totalX != null "> and total_x = #{totalX}</if>
            <if test="totalY != null "> and total_y = #{totalY}</if>
            <if test="xy != null "> and xy = #{xy}</if>
        </where>
    </select>
    
    <select id="selectFloorInfoById" parameterType="Long" resultMap="FloorInfoResult">
        <include refid="selectFloorInfoVo"/>
        where id = #{id}
    </select>
        
    <insert id="insertFloorInfo" parameterType="com.deer.wcs.base.model.FloorInfo" useGeneratedKeys="true" keyProperty="id">
        insert into floor_info
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="wareCode != null">ware_code,</if>
            <if test="wareName != null">ware_name,</if>
            <if test="areaCode != null">area_code,</if>
            <if test="z != null">z,</if>
            <if test="disableState != null">disable_state,</if>
            <if test="createTime != null">create_time,</if>
            <if test="createUserId != null">create_user_id,</if>
            <if test="createUserName != null">create_user_name,</if>
            <if test="totalX != null">total_x,</if>
            <if test="totalY != null">total_y,</if>
            <if test="xy != null">xy,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="wareCode != null">#{wareCode},</if>
            <if test="wareName != null">#{wareName},</if>
            <if test="areaCode != null">#{areaCode},</if>
            <if test="z != null">#{z},</if>
            <if test="disableState != null">#{disableState},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="createUserId != null">#{createUserId},</if>
            <if test="createUserName != null">#{createUserName},</if>
            <if test="totalX != null">#{totalX},</if>
            <if test="totalY != null">#{totalY},</if>
            <if test="xy != null">#{xy},</if>
         </trim>
    </insert>

    <update id="updateFloorInfo" parameterType="com.deer.wcs.base.model.FloorInfo">
        update floor_info
        <trim prefix="SET" suffixOverrides=",">
            <if test="wareCode != null">ware_code = #{wareCode},</if>
            <if test="wareName != null">ware_name = #{wareName},</if>
            <if test="areaCode != null">area_code = #{areaCode},</if>
            <if test="z != null">z = #{z},</if>
            <if test="disableState != null">disable_state = #{disableState},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="createUserId != null">create_user_id = #{createUserId},</if>
            <if test="createUserName != null">create_user_name = #{createUserName},</if>
            <if test="totalX != null">total_x = #{totalX},</if>
            <if test="totalY != null">total_y = #{totalY},</if>
            <if test="xy != null">xy = #{xy},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteFloorInfoById" parameterType="Long">
        delete from floor_info where id = #{id}
    </delete>

    <delete id="deleteFloorInfoByIds" parameterType="String">
        delete from floor_info where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>
<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.deer.wcs.base.dao.ProRouteMapper">
    
    <resultMap type="com.deer.wcs.base.model.ProRoute" id="ProRouteResult">
        <result property="id"    column="id"    />
        <result property="code"    column="code"    />
        <result property="name"    column="name"    />
        <result property="state"    column="state"    />
        <result property="wareCode"    column="ware_code"    />
        <result property="wareName"    column="ware_name"    />
    </resultMap>

    <resultMap id="Dto" extends="ProRouteResult"  type="com.deer.wcs.base.model.ProRouteDto" >
    </resultMap>

    <sql id="selectProRouteVo">
        select * from pro_route
    </sql>

    <delete id="deleteModel" parameterType="java.lang.Long"  >
        delete from pro_process where pro_route_id = #{proRouteId};
        <!-- delete from area_info where wareCode = #{wareCode}; -->
        delete from pro_route_process where pro_route_id = #{proRouteId};
        <!-- delete from position_handle where step_code in (select step_code from position_condition where ware_code = #{wareCode}); -->
        delete from pro_process_position where pro_route_id = #{proRouteId};
    </delete>
    <select id="findList" parameterType="com.deer.wcs.base.model.ProRouteCriteria" resultMap="Dto">
        <include refid="selectProRouteVo"/>
        <where>
            <if test="code != null  and code != ''"> and code = #{code}</if>
            <if test="name != null  and name != ''"> and name like concat('%', #{name}, '%')</if>
            <if test="state != null "> and state = #{state}</if>
            <if test="wareCode != null  and wareCode != ''"> and ware_code = #{wareCode}</if>
            <if test="wareName != null  and wareName != ''"> and ware_name like concat('%', #{wareName}, '%')</if>
        </where>
    </select>
    
    <select id="selectProRouteById" parameterType="Long" resultMap="ProRouteResult">
        <include refid="selectProRouteVo"/>
        where id = #{id}
    </select>
        
    <insert id="insertProRoute" parameterType="com.deer.wcs.base.model.ProRoute">
        insert into pro_route
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="id != null">id,</if>
            <if test="code != null">code,</if>
            <if test="name != null">name,</if>
            <if test="state != null">state,</if>
            <if test="wareCode != null">ware_code,</if>
            <if test="wareName != null">ware_name,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="id != null">#{id},</if>
            <if test="code != null">#{code},</if>
            <if test="name != null">#{name},</if>
            <if test="state != null">#{state},</if>
            <if test="wareCode != null">#{wareCode},</if>
            <if test="wareName != null">#{wareName},</if>
         </trim>
    </insert>

    <update id="updateProRoute" parameterType="com.deer.wcs.base.model.ProRoute">
        update pro_route
        <trim prefix="SET" suffixOverrides=",">
            <if test="code != null">code = #{code},</if>
            <if test="name != null">name = #{name},</if>
            <if test="state != null">state = #{state},</if>
            <if test="wareCode != null">ware_code = #{wareCode},</if>
            <if test="wareName != null">ware_name = #{wareName},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteProRouteById" parameterType="Long">
        delete from pro_route where id = #{id}
    </delete>

    <delete id="deleteProRouteByIds" parameterType="String">
        delete from pro_route where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>
<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.deer.wcs.task.dao.CallBoxRecordMapper">
    
    <resultMap type="com.deer.wcs.task.model.CallBoxRecord" id="CallBoxRecordResult">
        <result property="id"    column="id"    />
        <result property="callBoxInfoId"    column="call_box_info_id"    />
        <result property="code"    column="code"    />
        <result property="ip"    column="ip"    />
        <result property="type"    column="type"    />
        <result property="state"    column="state"    />
        <result property="btn"    column="btn"    />
        <result property="lampColor"    column="lamp_color"    />
        <result property="lampMode"    column="lamp_mode"    />
        <result property="lampTime"    column="lamp_time"    />
        <result property="lampCtrl"    column="lamp_ctrl"    />
        <result property="memo"    column="memo"    />
    </resultMap>

    <resultMap id="Dto" extends="CallBoxRecordResult"  type="com.deer.wcs.task.model.CallBoxRecordDto" >
    </resultMap>

    <sql id="selectCallBoxRecordVo">
        select * from call_box_record
    </sql>

    <select id="findList" parameterType="com.deer.wcs.task.model.CallBoxRecordCriteria" resultMap="Dto">
        select call_box_record.* from call_box_record call_box_record
        left join call_box_info call_box_info on call_box_record.call_box_info_id=call_box_info.id
        <where>  
            <if test="callBoxInfoId != null "> and call_box_info_id = #{callBoxInfoId}</if>
            <if test="code != null  and code != ''"> and code = #{code}</if>
            <if test="ip != null  and ip != ''"> and ip = #{ip}</if>
            <if test="type != null "> and type = #{type}</if>
            <if test="state != null "> and state = #{state}</if>
            <if test="btn != null "> and btn = #{btn}</if>
            <if test="lampColor != null  and lampColor != ''"> and lamp_color = #{lampColor}</if>
            <if test="lampMode != null "> and lamp_mode = #{lampMode}</if>
            <if test="lampTime != null "> and lamp_time = #{lampTime}</if>
            <if test="lampCtrl != null "> and lamp_ctrl = #{lampCtrl}</if>
            <if test="memo != null  and memo != ''"> and memo = #{memo}</if>
        </where>
        order by id desc
    </select>
    
    <select id="selectCallBoxRecordById" parameterType="Long" resultMap="CallBoxRecordResult">
        <include refid="selectCallBoxRecordVo"/>
        where id = #{id}
    </select>
        
    <insert id="insertCallBoxRecord" parameterType="com.deer.wcs.task.model.CallBoxRecord" useGeneratedKeys="true" keyProperty="id">
        insert into call_box_record
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="callBoxInfoId != null">call_box_info_id,</if>
            <if test="code != null">code,</if>
            <if test="ip != null">ip,</if>
            <if test="type != null">type,</if>
            <if test="state != null">state,</if>
            <if test="btn != null">btn,</if>
            <if test="lampColor != null">lamp_color,</if>
            <if test="lampMode != null">lamp_mode,</if>
            <if test="lampTime != null">lamp_time,</if>
            <if test="lampCtrl != null">lamp_ctrl,</if>
            <if test="memo != null">memo,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="callBoxInfoId != null">#{callBoxInfoId},</if>
            <if test="code != null">#{code},</if>
            <if test="ip != null">#{ip},</if>
            <if test="type != null">#{type},</if>
            <if test="state != null">#{state},</if>
            <if test="btn != null">#{btn},</if>
            <if test="lampColor != null">#{lampColor},</if>
            <if test="lampMode != null">#{lampMode},</if>
            <if test="lampTime != null">#{lampTime},</if>
            <if test="lampCtrl != null">#{lampCtrl},</if>
            <if test="memo != null">#{memo},</if>
         </trim>
    </insert>

    <update id="updateCallBoxRecord" parameterType="com.deer.wcs.task.model.CallBoxRecord">
        update call_box_record
        <trim prefix="SET" suffixOverrides=",">
            <if test="callBoxInfoId != null">call_box_info_id = #{callBoxInfoId},</if>
            <if test="code != null">code = #{code},</if>
            <if test="ip != null">ip = #{ip},</if>
            <if test="type != null">type = #{type},</if>
            <if test="state != null">state = #{state},</if>
            <if test="btn != null">btn = #{btn},</if>
            <if test="lampColor != null">lamp_color = #{lampColor},</if>
            <if test="lampMode != null">lamp_mode = #{lampMode},</if>
            <if test="lampTime != null">lamp_time = #{lampTime},</if>
            <if test="lampCtrl != null">lamp_ctrl = #{lampCtrl},</if>
            <if test="memo != null">memo = #{memo},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteCallBoxRecordById" parameterType="Long">
        delete from call_box_record where id = #{id}
    </delete>

    <delete id="deleteCallBoxRecordByIds" parameterType="String">
        delete from call_box_record where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>
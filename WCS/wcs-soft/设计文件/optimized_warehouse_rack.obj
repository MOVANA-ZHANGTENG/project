# 堆垛机仓库货架模型 (优化版)
# 生成时间：2024年
# 单位：米

# 货架参数说明：
# - 层数：5层
# - 列数：3列
# - 单格尺寸：2.0m(宽) × 1.0m(高) × 0.8m(深)
# - 材质：钢结构

# 顶点坐标 (v x y z)
# 货架主体框架顶点
v 0.0 0.0 0.0        # 顶点1: 左下前角
v 6.0 0.0 0.0        # 顶点2: 右下前角
v 6.0 5.0 0.0        # 顶点3: 右上前角
v 0.0 5.0 0.0        # 顶点4: 左上前角
v 0.0 0.0 0.8        # 顶点5: 左下后角
v 6.0 0.0 0.8        # 顶点6: 右下后角
v 6.0 5.0 0.8        # 顶点7: 右上后角
v 0.0 5.0 0.8        # 顶点8: 左上后角

# 立柱顶点 (4根立柱)
v 0.0 0.0 0.0        # 9: 左前下 (与1重合)
v 0.0 5.0 0.0        # 10: 左前上 (与4重合)
v 6.0 0.0 0.0        # 11: 右前下 (与2重合)
v 6.0 5.0 0.0        # 12: 右前上 (与3重合)
v 0.0 0.0 0.8        # 13: 左后下 (与5重合)
v 0.0 5.0 0.8        # 14: 左后上 (与8重合)
v 6.0 0.0 0.8        # 15: 右后下 (与6重合)
v 6.0 5.0 0.8        # 16: 右后上 (与7重合)

# 横梁顶点 (每层都有前后横梁)
# 第一层横梁
v 0.0 1.0 0.0        # 17: 左前一
v 6.0 1.0 0.0        # 18: 右前一
v 0.0 1.0 0.8        # 19: 左后一
v 6.0 1.0 0.8        # 20: 右后一

# 第二层横梁
v 0.0 2.0 0.0        # 21: 左前二
v 6.0 2.0 0.0        # 22: 右前二
v 0.0 2.0 0.8        # 23: 左后二
v 6.0 2.0 0.8        # 24: 右后二

# 第三层横梁
v 0.0 3.0 0.0        # 25: 左前三
v 6.0 3.0 0.0        # 26: 右前三
v 0.0 3.0 0.8        # 27: 左后三
v 6.0 3.0 0.8        # 28: 右后三

# 第四层横梁
v 0.0 4.0 0.0        # 29: 左前四
v 6.0 4.0 0.0        # 30: 右前四
v 0.0 4.0 0.8        # 31: 左后四
v 6.0 4.0 0.8        # 32: 右后四

# 纵梁顶点 (分隔货格)
v 2.0 0.0 0.0        # 33: 前一纵
v 2.0 5.0 0.0        # 34: 前二纵
v 4.0 0.0 0.0        # 35: 前三纵
v 4.0 5.0 0.0        # 36: 前四纵
v 2.0 0.0 0.8        # 37: 后一纵
v 2.0 5.0 0.8        # 38: 后二纵
v 4.0 0.0 0.8        # 39: 后三纵
v 4.0 5.0 0.8        # 40: 后四纵

# 纹理坐标 (vt u v)
vt 0.0 0.0
vt 1.0 0.0
vt 1.0 1.0

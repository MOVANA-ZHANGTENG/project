    <resultMap id="Dto" extends="RcsCarTaskResult"  type="com.deer.wcs.rcs.model.RcsCarTaskDto" >
    </resultMap>

    <sql id="selectRcsCarTaskVo">
        select id, task_code, task_type, priority, create_time, create_user_name, allot_car_id, from_cell_code, to_cell_code, pallet_code, status, start_time, end_time, duration, error_code, error_message from rcs_car_task
    </sql>

    <select id="findList" parameterType="com.deer.wcs.rcs.model.RcsCarTaskCriteria" resultMap="Dto">
        <include refid="selectRcsCarTaskVo"/>
        <where>  
            <if test="id != null "> and id = #{id}</if>
            <if test="taskCode != null  and taskCode != ''"> and task_code like concat('%', #{taskCode}, '%')</if>
            <if test="taskType != null  and taskType != ''"> and task_type = #{taskType}</if>
            <if test="createTime != null  and createTime != ''"> and create_time like concat('%', #{createTime}, '%')</if>
            <if test="createUserName != null  and createUserName != ''"> and create_user_name like concat('%', #{createUserName}, '%')</if>
            <if test="allotCarId != null "> and allot_car_id = #{allotCarId}</if>
            <if test="fromCellCode != null  and fromCellCode != ''"> and from_cell_code = #{fromCellCode}</if>
            <if test="toCellCode != null  and toCellCode != ''"> and to_cell_code = #{toCellCode}</if>
            <if test="palletCode != null  and palletCode != ''"> and pallet_code = #{palletCode}</if>
            <if test="status != null  and status != ''"> and status = #{status}</if>
            <if test="startTime != null  and startTime != ''"> and start_time like concat('%', #{startTime}, '%')</if>
            <if test="endTime != null  and endTime != ''"> and end_time like concat('%', #{endTime}, '%')</if>
        </where>
    </select>
    
    <select id="selectRcsCarTaskById" parameterType="Long" resultMap="RcsCarTaskResult">
        <include refid="selectRcsCarTaskVo"/>
        where id = #{id}
    </select>
        
    <insert id="insertRcsCarTask" parameterType="com.deer.wcs.rcs.model.RcsCarTask" useGeneratedKeys="true" keyProperty="id">
        insert into rcs_car_task
        <trim prefix="(" suffix=")" suffixOverrides=",">

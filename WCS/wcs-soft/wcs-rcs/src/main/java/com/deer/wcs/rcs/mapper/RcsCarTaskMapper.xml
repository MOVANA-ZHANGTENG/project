        delete from rcs_car_task where id = #{id}
    </delete>

    <delete id="deleteRcsCarTaskByIds" parameterType="String">
        delete from rcs_car_task where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

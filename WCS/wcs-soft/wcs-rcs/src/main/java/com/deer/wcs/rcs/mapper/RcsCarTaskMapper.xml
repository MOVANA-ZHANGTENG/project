<mapper namespace="com.deer.wcs.rcs.dao.RcsCarTaskMapper">
    
    <resultMap type="com.deer.wcs.rcs.model.RcsCarTask" id="RcsCarTaskResult">
        <result property="id"    column="id"    />
        <result property="taskCode"    column="task_code"    />
        <result property="taskType"    column="task_type"    />
        <result property="priority"    column="priority"    />
        <result property="createTime"    column="create_time"    />
        <result property="createUserName"    column="create_user_name"    />
        <result property="allotCarId"    column="allot_car_id"    />
        <result property="fromCellCode"    column="from_cell_code"    />
        <result property="toCellCode"    column="to_cell_code"    />
        <result property="palletCode"    column="pallet_code"    />
